// ForgeDesk — Phase 2 schema
// Adds: Session, EmailOtp, PasswordResetToken on top of the Phase 1 core model
// + OAuthAccount for Google sign-in

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  WINNERS_SELECTED
  COMPLETED
  ARCHIVED
}

enum TaskType {
  FOLLOW
  LIKE
  REPOST
  POST
  COMMENT
  JOIN_COMMUNITY
  REFERRAL
  MEME
  VIDEO
  IMAGE
  CUSTOM
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_PROOF_REQUIRED
}

enum WinnerStatus {
  SELECTED
  ANNOUNCED
  REWARD_PENDING
  REWARDED
  DISQUALIFIED
}

enum RewardStatus {
  PENDING
  CONTACTED
  PAID
  FAILED
  CANCELLED
}

enum OtpPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String     @unique
  firstName     String
  lastName      String
  passwordHash  String? // optional — Google OAuth users have no password
  emailVerified Boolean    @default(false)
  pendingEmail  String? // optional — used for change-email flow if you use it
  status        UserStatus @default(ACTIVE)
  isAdmin       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  participations Participation[]
  submissions    Submission[]
  winners        Winner[]
  sessions       Session[]
  emailOtps      EmailOtp[]
  resetTokens    PasswordResetToken[]
  oauthAccounts  OAuthAccount[]

  @@index([email])
  @@index([username])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A row exists here for as long as a login session is valid.
// The cookie only ever holds a random token — we store its hash,
// so a stolen database dump can't be replayed as a valid cookie.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Used for both email verification and password reset OTPs,
// distinguished by `purpose`. Code is hashed, never stored plain.
model EmailOtp {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  website     String?
  twitter     String?
  telegram    String?
  discord     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id                String         @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id])
  title             String
  slug              String         @unique
  description       String
  rules             String?
  coverImageUrl     String?
  status            CampaignStatus @default(DRAFT)
  participantLimit  Int?
  winnerCount       Int
  rewardDescription String
  startAt           DateTime
  endAt             DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tasks          CampaignTask[]
  participations Participation[]
  submissions    Submission[]
  winners        Winner[]

  @@index([status])
  @@index([slug])
}

model CampaignTask {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  type         TaskType
  title        String
  description  String
  instructions String
  required     Boolean  @default(true)
  sortOrder    Int      @default(0)

  submissions Submission[]

  @@index([campaignId])
}

model Participation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  joinedAt   DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model Submission {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id])
  taskId     String
  task       CampaignTask     @relation(fields: [taskId], references: [id])
  status     SubmissionStatus @default(PENDING)
  proofUrl   String?
  proofText  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  history SubmissionHistory[]

  @@index([campaignId, status])
  @@index([userId])
}

model SubmissionHistory {
  id           String           @id @default(cuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id])
  status       SubmissionStatus
  note         String?
  actedBy      String
  createdAt    DateTime         @default(now())

  @@index([submissionId])
}

model Winner {
  id                String       @id @default(cuid())
  campaignId        String
  campaign          Campaign     @relation(fields: [campaignId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  selectedBy        String
  selectedAt        DateTime     @default(now())
  status            WinnerStatus @default(SELECTED)
  rewardDescription String
  adminNotes        String?

  reward RewardRecord?

  @@unique([campaignId, userId])
  @@index([campaignId])
}

model RewardRecord {
  id              String       @id @default(cuid())
  winnerId        String       @unique
  winner          Winner       @relation(fields: [winnerId], references: [id])
  status          RewardStatus @default(PENDING)
  paymentMethod   String?
  paymentRef      String?
  transactionHash String?
  paidAt          DateTime?
  adminNotes      String?
  updatedAt       DateTime     @updatedAt
}

model ProjectRequest {
  id                    String   @id @default(cuid())
  projectName           String
  contactName           String
  email                 String
  website               String?
  twitter               String?
  telegram              String?
  discord               String?
  description           String
  campaignIdea          String
  campaignType          String?
  estimatedParticipants String?
  budget                String?
  message               String?
  status                String   @default("NEW")
  createdAt             DateTime @default(now())
}